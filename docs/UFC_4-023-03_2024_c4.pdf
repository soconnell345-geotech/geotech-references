<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link id="site-favicon" rel="icon" href="https://www.wbdg.org/api/settings/website/favicon" />
    <script>
      // Fall back to the static logo if the backend favicon fails to load
      // (e.g. no favicon configured, 404, or an invalid/empty response).
      (function () {
        var DEFAULT_FAVICON = "/logo.svg";
        var probe = new Image();
        probe.onerror = function () {
          var link = document.getElementById("site-favicon");
          if (link) link.href = DEFAULT_FAVICON;
        };
        probe.src = "https://www.wbdg.org/api/settings/website/favicon";
      })();
    </script>
